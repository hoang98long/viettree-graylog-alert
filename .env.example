APP_NAME=ASA Config Monitor
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
GRAYLOG_URL=http://192.168.10.10:9000
GRAYLOG_USERNAME=
GRAYLOG_PASSWORD=
GRAYLOG_VERIFY_SSL=false
GRAYLOG_SEARCH_ENDPOINT=/api/search/universal/relative
GRAYLOG_SEARCH_QUERY=source:192.168.1.1
ASA_IP=192.168.1.1
POLL_INTERVAL_SECONDS=5
INITIAL_LOOKBACK_SECONDS=60
POLL_OVERLAP_SECONDS=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=sqlite:///./data/asa_monitor.db
ENABLE_TELEGRAM=true
MOCK_GRAYLOG=false
